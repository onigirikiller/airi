# WARNING: this file is TRACKED BY GIT and is published with the repository.
# It must contain public defaults and placeholder values only.
# Put real API keys, tokens and endpoints in .env.local next to this file: the service loads
# --env-file=.env first and --env-file-if-exists=.env.local second, so .env.local wins and is
# gitignored.

# Satori Configuration
SATORI_WS_URL=ws://localhost:5140/satori/v1/events
SATORI_API_BASE_URL=http://localhost:5140/satori/v1
SATORI_TOKEN=your_satori_token_here

# LLM Configuration
LLM_API_KEY='local-dev'
LLM_API_BASE_URL='http://localhost:11434/v1'
LLM_MODEL='qwen2.5:7b-instruct'
LLM_RESPONSE_LANGUAGE=English
LLM_OLLAMA_DISABLE_THINK=false
